{
  "name": "hackyeah",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22.12.0", "pnpm": ">=12" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@hackyeah/frontend --filter=@hackyeah/backend",
    "dev:presentation": "pnpm --filter @hackyeah/presentation dev",
    "build": "turbo run build",
    "build:app": "turbo run build --filter=@hackyeah/backend...",
    "start": "pnpm --filter @hackyeah/backend start",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm --filter @hackyeah/frontend lint",
    "context": "node scripts/context.mjs"
  },
  "devDependencies": { "turbo": "latest" }
}
